[sub_resource type="GDScript" id="GDScript_ka5ae"]
script/source = "extends StaticBody3D


# Called when the node enters the scene tree for the first time.
func _ready():
	Signals.object_interacted.connect(func(object):
		if object.name == \"InstantCoffee\":
			name = \"LukewarmCoffee\"
			var pos = position
			position.y = 100
			await get_tree().create_timer(0.5).timeout
			position = pos
		elif object.name == \"LukewarmCoffee\":
			position.y = 100
		)


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta):
	pass
"

